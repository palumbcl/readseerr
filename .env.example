# === Auth (NextAuth.js) ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# === Authelia OIDC Provider ===
AUTHELIA_CLIENT_ID=readseerr
AUTHELIA_CLIENT_SECRET=your_authelia_client_secret_here
AUTHELIA_ISSUER_URL=https://auth.example.com

# === Database ===
DATABASE_URL=file:./readseerr.db

# === ComicVine (Comics US) ===
# Get your free key at: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=your_comicvine_api_key_here

# === Google Books (BD) — optional but recommended ===
# Without a key the anonymous daily quota is shared and runs out quickly (HTTP 429).
# Create one at: https://console.cloud.google.com/apis/credentials (enable "Books API")
GOOGLE_BOOKS_API_KEY=

# === Kaizoku (Manga downloader - ghcr.io/oae/kaizoku:latest) ===
KAIZOKU_URL=http://kaizoku:3000

# === Mylar3 (Comic/BD downloader) ===
MYLAR_URL=http://mylar3:8090
MYLAR_API_KEY=your_mylar3_api_key_here

# === Email Notifications (Nodemailer) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# === Discord Webhook (Admin Notifications) ===
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# === Prowlarr — optional: adds a "Chercher sur Prowlarr" link to Discord notifications ===
# Must be the URL you open in your browser (not the internal Docker hostname)
PROWLARR_URL=https://prowlarr.example.com

# === Komga — optional: flags requests for series already in the library ===
# KOMGA_URL is used server-side (can be the Docker hostname); KOMGA_PUBLIC_URL is used for Discord links
KOMGA_URL=http://komga:25600
KOMGA_PUBLIC_URL=https://komga.example.com
# Either an API key (Komga > Account settings > API Keys) or a user/password
KOMGA_API_KEY=
KOMGA_USER=
KOMGA_PASSWORD=
KOMGA_WEBHOOK_SECRET=your_komga_webhook_secret_here
