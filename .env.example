# === Auth (NextAuth.js) ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# === Authelia OIDC Provider ===
AUTHELIA_CLIENT_ID=readseerr
AUTHELIA_CLIENT_SECRET=your_authelia_client_secret_here
AUTHELIA_ISSUER_URL=https://auth.example.com

# === Database ===
DATABASE_URL=file:./readseerr.db

# === ComicVine (Comics US) ===
# Get your free key at: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=your_comicvine_api_key_here

# === Kaizoku (Manga downloader - ghcr.io/oae/kaizoku:latest) ===
KAIZOKU_URL=http://kaizoku:3000

# === Mylar3 (Comic/BD downloader) ===
MYLAR_URL=http://mylar3:8090
MYLAR_API_KEY=your_mylar3_api_key_here

# === Email Notifications (Nodemailer) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# === Discord Webhook (Admin Notifications) ===
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
