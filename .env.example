# === Auth (NextAuth.js) ===
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# === Authelia OIDC Provider ===
AUTHELIA_CLIENT_ID=readseerr
AUTHELIA_CLIENT_SECRET=your_authelia_client_secret_here
AUTHELIA_ISSUER_URL=https://auth.example.com
# Optional: members of this Authelia group become ReadSeerr admins on login
AUTHELIA_ADMIN_GROUP=

# === Admins — optional: comma-separated emails. When set, these accounts are the ONLY admins
# (roles can no longer be changed from the UI). When empty, roles are managed in /admin.
ADMIN_EMAILS=

# === Database ===
DATABASE_URL=file:./readseerr.db

# Komga, Discord, Prowlarr, SMTP and ComicVine can also be configured (and tested) in
# ReadSeerr > Administration > Paramètres: a value saved there overrides the variable below.

# === ComicVine (Comics US) ===
# Get your free key at: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=your_comicvine_api_key_here

# === Email Notifications (Nodemailer) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# === Discord Webhook (Admin Notifications) ===
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# === Prowlarr — optional: adds a "Chercher sur Prowlarr" link to Discord notifications ===
# Must be the URL you open in your browser (not the internal Docker hostname)
PROWLARR_URL=https://prowlarr.example.com

# === Komga — optional: availability badges, library sync, auto-closing fulfilled requests ===
# KOMGA_URL is used server-side (can be the Docker hostname); KOMGA_PUBLIC_URL is used for Discord links
KOMGA_URL=http://komga:25600
KOMGA_PUBLIC_URL=https://komga.example.com
# Either an API key (Komga > Account settings > API Keys) or a user/password
KOMGA_API_KEY=
KOMGA_USER=
KOMGA_PASSWORD=
KOMGA_WEBHOOK_SECRET=your_komga_webhook_secret_here
# How often the library is re-synced (availability badges, auto-closing requests). Min 5, default 30
KOMGA_SYNC_INTERVAL_MINUTES=30
# "true": readers can sign in with their Komga email + password (account created on first login)
KOMGA_LOGIN_ENABLED=false

# === Push notifications — optional (also editable in Administration > Paramètres) ===
# ntfy: admin alerts go to NTFY_ADMIN_TOPIC; each reader picks a personal topic in "Mon compte"
NTFY_URL=https://ntfy.sh
NTFY_ADMIN_TOPIC=
NTFY_TOKEN=
# Gotify: admin alerts only (application token)
GOTIFY_URL=
GOTIFY_TOKEN=
