datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  requests     Request[]
}

model Request {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  mediaType     String   // "manga" | "comic" | "bd"
  externalId    String
  title         String
  coverUrl      String?
  volumes       String?  // JSON array string e.g. "[1,2,3]"
  status        String   @default("pending") // pending | sent | success | error
  targetService String   // "kaizoku" | "mylar3"
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
