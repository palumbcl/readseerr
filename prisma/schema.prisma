datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  emailVerified DateTime?
  image        String?
  passwordHash String?
  role         String    @default("user") // "user" | "admin"
  createdAt    DateTime  @default(now())
  requests     Request[]
  handledRequests Request[] @relation("HandledRequests")
  follows      Follow[]
  issues       Issue[]
  resolvedIssues Issue[] @relation("ResolvedIssues")
  issueComments IssueComment[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Une œuvre (série) demandée au moins une fois : porte le statut agrégé de toutes ses demandes.
model Media {
  id            String    @id @default(cuid())
  mediaType     String    // "manga" | "comic" | "bd"
  externalId    String
  title         String
  altTitles     String?   // JSON array : autres titres connus (romaji, anglais…) pour le rapprochement Komga
  year          Int?
  coverUrl      String?
  volumeCount   Int?      // nombre de tomes connu à la source
  status        String    @default("unknown") // unknown | pending | processing | partially_available | available
  komgaSeriesId String?
  libraryBooksCount Int?  // tomes vus dans Komga au dernier passage (détection des nouveaux tomes des séries suivies)
  availableAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requests      Request[]
  follows       Follow[]
  issues        Issue[]

  @@unique([mediaType, externalId])
  @@index([status])
}

model Request {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  mediaId       String
  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaType     String    // "manga" | "comic" | "bd"
  externalId    String
  title         String
  coverUrl      String?
  volumes       String?   // JSON array string e.g. "[1,2,3]"
  status        String    @default("pending") // pending | approved | declined | available
  declineReason String?
  handledById   String?
  handledBy     User?     @relation("HandledRequests", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([mediaId])
  @@index([status])
}

/// Série suivie par un lecteur : notification des nouveaux tomes (Komga) et des nouvelles sorties (comics).
model Follow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  autoRequest Boolean  @default(false) // demande automatique des nouveaux numéros parus
  createdAt   DateTime @default(now())

  @@unique([userId, mediaId])
  @@index([mediaId])
}

/// Problème signalé sur une œuvre disponible (tome manquant, fichier illisible…).
model Issue {
  id           String         @id @default(cuid())
  mediaId      String
  media        Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String         // missing_volume | bad_file | wrong_content | metadata | other
  volume       Int?           // tome concerné, si précisé
  message      String
  status       String         @default("open") // open | resolved
  resolvedById String?
  resolvedBy   User?          @relation("ResolvedIssues", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  comments     IssueComment[]

  @@index([status])
  @@index([userId])
  @@index([mediaId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([issueId])
}

/// Copie locale des séries Komga, rafraîchie par la synchronisation (badges de disponibilité).
model LibrarySeries {
  id         String   @id // identifiant Komga
  name       String
  titles     String   // JSON array des titres normalisés (titre, nom du dossier, titres alternatifs)
  year       Int?
  booksCount Int
  syncedAt   DateTime @default(now())
}
